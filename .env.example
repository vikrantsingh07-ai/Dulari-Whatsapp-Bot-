# Copy to .env (git-ignored). Real values live in the password vault + hosting env vars.
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://your-app.up.railway.app

# Postgres (Supabase, Mumbai). Use the pooled/direct connection string.
DATABASE_URL=postgres://user:pass@host:5432/postgres

# Meta WhatsApp Cloud API (system user permanent token)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=918851472382
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Local dev must point at Meta's TEST number, never the real one.
WHATSAPP_IS_TEST_NUMBER=true

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
# Optional, USD per million tokens, to fill llm_calls.cost (left null if unset)
PRICE_MAIN_IN_PER_MTOK=
PRICE_MAIN_OUT_PER_MTOK=
PRICE_FAST_IN_PER_MTOK=
PRICE_FAST_OUT_PER_MTOK=

# Brain / Leads sheets (Google service account with Sheets API)
BRAIN_SOURCE=sheet            # sheet | file (file = fixtures/brain.sample.json, dev/tests only)
BRAIN_SHEET_ID=
LEADS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=  # full JSON on one line, or base64 of it

# Shopify (read_products only) - optional, sheet photo URLs work without it
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

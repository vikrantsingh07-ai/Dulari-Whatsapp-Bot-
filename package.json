{
  "name": "dulari-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "replay": "tsx test/replay/run.ts",
    "set-webhooks": "tsx scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "google-auth-library": "^11.3.2",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
